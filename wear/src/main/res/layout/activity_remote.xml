<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

        <!-- Connection status pill at top -->
        <TextView
            android:id="@+id/tvConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_active"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Checking..."
            android:textColor="?colorOnSurface"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Status text below connection pill -->

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="150dp"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text=""
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Shutter (white, large) at center -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_btn_shutter"
            android:scaleType="centerInside"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Capture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Scroll mode right at 45° -->
        <ImageButton
            android:id="@+id/btnScrollRight"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_video"
            android:src="@drawable/ic_chevron_right"
            android:tint="#000000"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Scroll Mode Right"
            app:layout_constraintCircle="@id/btnCapture"
            app:layout_constraintCircleAngle="45"
            app:layout_constraintCircleRadius="85dp" />

        <!-- Switch Camera at 135° -->
        <ImageButton
            android:id="@+id/btnSwitch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_switch"
            android:src="@drawable/ic_flip_camera"
            android:tint="#000000"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Switch Camera"
            app:layout_constraintCircle="@id/btnCapture"
            app:layout_constraintCircleAngle="135"
            app:layout_constraintCircleRadius="85dp" />

        <!-- Timer at 225° -->
        <ImageButton
            android:id="@+id/btnTimer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_timer"
            android:src="@drawable/ic_timer"
            android:tint="#000000"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:contentDescription="Timer"
            app:layout_constraintCircle="@id/btnCapture"
            app:layout_constraintCircleAngle="225"
            app:layout_constraintCircleRadius="85dp" />

        <!-- Scroll mode left at 315° -->
        <ImageButton
            android:id="@+id/btnScrollLeft"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_camera"
            android:clipToOutline="true"
            android:contentDescription="Scroll Mode Left"
            android:outlineProvider="background"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_left"
            android:tint="#000000"
            app:layout_constraintCircle="@id/btnCapture"
            app:layout_constraintCircleAngle="315"
            app:layout_constraintCircleRadius="85dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
